# Copy to .env for local Compose or VPS deployment. Generate unique, long random values for every password/secret.
DPDMS_DOMAIN=localhost
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
MYSQL_APP_PASSWORD=replace-with-a-unique-database-password
DPDMS_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-grafana-password
DPDMS_BOOTSTRAP_ADMIN_USERNAME=admin@example.org
DPDMS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password-at-least-12-characters
DPDMS_ALLOW_ALL_HAZARD_DEMO_SCOPES=false

# DNS server used by the alert container for external providers (set to a resolver reachable from Docker)
DPDMS_DNS_SERVER=1.1.1.1

# Email delivery (optional until configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
DPDMS_ALERT_EMAIL=

# WhatsApp Cloud API (configure these on the VPS, never commit them)
DPDMS_ALERT_WHATSAPP_TO=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
